index 5f5b665..8cdec0a 100644
--- a/xtensa-lx7/src/exec.rs
+++ b/xtensa-lx7/src/exec.rs
@@ -4,0 +5,4 @@ use crate::state::*;
+use std::collections::BTreeMap;
+use std::sync::{Mutex, OnceLock};
+
+static OPCODE_COUNTS: OnceLock<Mutex<BTreeMap<String, u64>>> = OnceLock::new();
@@ -18,0 +23,34 @@ pub enum Trap {
+fn record_opcode(i: &Insn) {
+    if std::env::var_os("ESP32SIM_OPCODE_HISTOGRAM").is_none() {
+        return;
+    }
+    let mnemonic = crate::disasm::format(i)
+        .split_whitespace()
+        .next()
+        .unwrap_or("illegal")
+        .to_string();
+    *OPCODE_COUNTS
+        .get_or_init(|| Mutex::new(BTreeMap::new()))
+        .lock()
+        .expect("opcode histogram mutex")
+        .entry(mnemonic)
+        .or_default() += 1;
+}
+
+pub fn write_opcode_histogram() -> std::io::Result<()> {
+    use std::io::Write;
+
+    let Some(path) = std::env::var_os("ESP32SIM_OPCODE_HISTOGRAM") else {
+        return Ok(());
+    };
+    let counts = OPCODE_COUNTS
+        .get_or_init(|| Mutex::new(BTreeMap::new()))
+        .lock()
+        .expect("opcode histogram mutex");
+    let mut output = std::io::BufWriter::new(std::fs::File::create(path)?);
+    for (opcode, count) in counts.iter() {
+        writeln!(output, "{opcode}\t{count}")?;
+    }
+    Ok(())
+}

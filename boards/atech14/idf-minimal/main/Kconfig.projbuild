menu "Atech Sim"
    config ATECH_LED_GPIO
        int "LED GPIO"
        default 4
    config ATECH_BUTTON_GPIO
        int "Button GPIO (active low, internal pull-up)"
        default 5
    config ATECH_WIFI_ENABLE
        bool "Connect to WiFi at boot"
        default y
    config ATECH_WIFI_SSID
        string "WiFi SSID"
        default "Wokwi-GUEST"
        depends on ATECH_WIFI_ENABLE
    config ATECH_WIFI_PASS
        string "WiFi password"
        default ""
        depends on ATECH_WIFI_ENABLE
endmenu

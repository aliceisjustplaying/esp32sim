#!/usr/bin/env bash
# Pre-commit gate. Enable once per clone with:
#   git config core.hooksPath .githooks
# Runs the full safeguard battery (fmt, check, strict clippy, debug and
# release tests, rustdoc) via scripts/pre-commit.sh whenever staged
# changes touch code or build configuration. Documentation-only commits
# skip the cargo battery.
set -euo pipefail

if git diff --cached --name-only | grep -qE '\.(rs|toml|lock)$|^scripts/|^\.githooks/|^tools/'; then
  if [ -x scripts/pre-commit.sh ]; then
    ./scripts/pre-commit.sh
  else
    echo "pre-commit: scripts/pre-commit.sh not present yet (rust-safeguards" >&2
    echo "pre-commit: not harvested); code checks SKIPPED. Task 1 arms this gate." >&2
  fi
else
  echo "pre-commit: no code or build files staged; skipping the cargo battery"
fi

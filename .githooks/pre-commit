#!/usr/bin/env bash
# Fast commit gate: strict clippy. The full battery (tests, rustdoc) runs in
# pre-push.
# Enable once per clone with: git config core.hooksPath .githooks
set -euo pipefail

if git diff --cached --name-only | grep -qE '\.(rs|toml|lock)$|^scripts/|^\.githooks/|^tools/'; then
  if [ -x scripts/pre-commit.sh ]; then
    cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
  else
    echo "pre-commit: scripts/pre-commit.sh not present yet (rust-safeguards" >&2
    echo "pre-commit: not harvested); clippy SKIPPED. Task 1 arms this gate." >&2
  fi
else
  echo "pre-commit: no code or build files staged; skipping cargo checks"
fi
